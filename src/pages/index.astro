---



import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import { socials } from '../config/socials';
import avatar from '../images/avatar.jpg';
import Layout from '../layouts/Layout.astro';
import { formatCardDate, isPublished, sortByDateDesc, toEntry } from '../utils/content';

const allPosts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
const [latestPost, ...olderPosts] = allPosts;
const morePosts = olderPosts.slice(0, 3);

const allProjects = (await getCollection('projects', isPublished).catch(() => [])).sort(sortByDateDesc);
const featuredProjects = allProjects.slice(0, 3);

// The track record, newest first. Each line is a claim the work can back up.
const record = [
  {
    when: 'Now',
    where: 'Oogway Labs',
    href: 'https://oogwaylabs.com/',
    role: 'Founder & CEO',
    what: 'An AI consulting and engineering firm. We build the systems, not the slide deck.',
  },
  {
    when: 'Before',
    where: 'Cornet Health',
    role: 'Co-founder & CTO',
    what: 'Voice-first AI for clinicians, where 95% transcription accuracy turned out to be the easy part.',
  },
  {
    when: 'Before that',
    where: 'Ather Energy',
    role: 'Connected Platforms, Data & AI',
    what: 'Took early experiments to infrastructure behind 500,000+ electric scooters on Indian roads.',
  },
  {
    when: 'Earlier',
    where: 'E-commerce, retail & supply chain',
    role: 'Data science & product',
    what: 'Data platforms that made operational decisions faster and a little less argumentative.',
  },
];
---

<Layout title="Soumyo Dey">
  <!-- Hero: who, in one breath, then straight to the work -->
  <section class="row hero" aria-label="Introduction">
    <div class="hero-aside marginalia">
      <div class="hero-avatar">
        <Picture
          src={avatar}
          widths={[72, 144]}
          sizes="72px"
          formats={['avif', 'webp', 'jpeg']}
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p>Builder, systems thinker, occasional essayist</p>
    </div>

    <div>
      <h1 class="display">Soumyo Dey</h1>

      <p class="lead hero-lede">
        A decade of building systems that have to work outside the demo: connected
        platforms for half a million electric scooters, voice AI in clinics, data
        platforms for retail. I write about what held up, and what broke at 3am.
      </p>

      <div class="hero-actions">
        <a href="/blog" class="btn" data-astro-prefetch>Read the writing</a>
        <a href="/about" class="link-quiet" data-astro-prefetch>More about me</a>
      </div>

      <ul class="hero-elsewhere" aria-label="Elsewhere">
        {socials.filter((s) => s.platform !== 'email').map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Latest essay -->
  {latestPost && (
    <section class="row ruled section" aria-labelledby="latest-title">
      <p class="marginalia">
        Latest essay<br />
        <time datetime={new Date(latestPost.data.date).toISOString()}>{formatCardDate(latestPost.data.date, 'long')}</time>
      </p>
      <div>
        <h2 id="latest-title" class="page-title latest-title">
          <a href={`/blog/${latestPost.id}`} data-astro-prefetch>{latestPost.data.title}</a>
        </h2>
        {latestPost.data.subtitle && <p class="lead latest-sub">{latestPost.data.subtitle}</p>}
        {latestPost.data.description && <p class="body-serif latest-desc">{latestPost.data.description}</p>}
        <p class="latest-more">
          <a href={`/blog/${latestPost.id}`} class="link-quiet" data-astro-prefetch>Read it<span aria-hidden="true"> →</span></a>
        </p>
      </div>
    </section>
  )}

  <!-- Track record: receipts, not metrics -->
  <section class="section" aria-labelledby="record-title">
    <div class="row ruled">
      <p class="marginalia">
        Startups and scaled platforms, mostly in places where software meets
        hardware, clinics, or warehouses, and has to behave.
      </p>
      <h2 id="record-title" class="section-title">Where the work has been</h2>
    </div>

    <ol class="record">
      {record.map((item) => (
        <li class="row record-item">
          <p class="marginalia record-when">{item.when}</p>
          <div>
            <h3 class="record-where">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">{item.where}</a>
              ) : (
                item.where
              )}
              <span class="record-role">{item.role}</span>
            </h3>
            <p class="body-serif record-what">{item.what}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Built work (only when there are real write-ups to show) -->
  {featuredProjects.length > 0 && (
    <section class="section" aria-labelledby="built-title">
      <div class="row ruled">
        <p class="marginalia"><a href="/projects" class="link-primary" data-astro-prefetch>All work</a></p>
        <h2 id="built-title" class="section-title">Things I've built</h2>
      </div>
      <PostList level={3} items={featuredProjects.map(toEntry)} />
    </section>
  )}

  <!-- More writing -->
  {morePosts.length > 0 && (
    <section class="section" aria-labelledby="more-title">
      <div class="row ruled">
        <div class="marginalia">
          <p>
            On AI systems, product judgment, and the distance between the
            benchmark and the real thing.
          </p>
          <p class="more-link"><a href="/blog" class="link-primary" data-astro-prefetch>All essays<span aria-hidden="true"> →</span></a></p>
        </div>
        <h2 id="more-title" class="section-title">More writing</h2>
      </div>
      <PostList level={3} items={morePosts.map(toEntry)} />
    </section>
  )}

  <!-- Newsletter -->
  <section id="newsletter-section" class="section" aria-labelledby="newsletter-title">
    <div class="row ruled">
      <p class="marginalia">
        New essays by email, sent when there's something worth saying rather
        than on a schedule. Unsubscribe whenever; no hard feelings.
      </p>
      <div>
        <h2 id="newsletter-title" class="section-title">Stochastic Musings</h2>
        <div class="newsletter-actions">
          <a
            href="https://stochasticmusings.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
          >
            Subscribe on Substack
          </a>
          <a href="/rss.xml" class="link-quiet">or use RSS</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
    align-items: start;
  }

  .hero-aside {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .hero-aside::before {
    display: none;
  }

  .hero-aside p {
    max-width: 9rem;
  }

  @media (min-width: 48rem) {
    .hero-aside {
      display: block;
      padding-top: 1rem;
      margin-bottom: 0;
    }

    .hero-aside::before {
      display: block;
    }

    .hero-aside p {
      margin-top: 0.75rem;
    }
  }

  .hero-avatar {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .hero-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-lede {
    margin-top: 2rem;
    max-width: 36rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .hero-elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 1rem;
  }

  .hero-elsewhere a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-ui);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.3em;
  }

  .hero-elsewhere a:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
  }

  .latest-title {
    max-width: 32rem;
  }

  .latest-title a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .latest-title a:hover {
    text-decoration-color: var(--color-accent);
  }

  .latest-sub {
    margin-top: 1rem;
    max-width: 34rem;
  }

  .latest-desc {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  .latest-more {
    margin-top: 1.25rem;
  }

  .more-link {
    margin-top: 1rem;
  }

  .record-item {
    padding-block: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .record-item:last-child {
    border-bottom: 0;
  }

  .record-when {
    padding-top: 0.35rem;
  }

  .record-where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.75rem;
    font-size: var(--text-h3);
    line-height: 1.2;
    color: var(--color-text);
  }

  .record-where a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    text-underline-offset: 0.2em;
  }

  .record-where a:hover {
    color: var(--color-accent);
  }

  .record-role {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    color: var(--color-text-muted);
  }

  .record-what {
    margin-top: 0.5rem;
    max-width: 36rem;
  }

  .newsletter-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.5rem;
  }
</style>
