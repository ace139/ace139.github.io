---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import PostIndex from '../components/PostIndex.astro';
import { socials } from '../config/socials';
// Tight black-and-white crop of avatar.jpg, made to sit in the monochrome grid.
import avatar from '../images/avatar-portrait.jpg';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toIndexItem } from '../utils/content';

const allPosts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
const [latestPost, ...olderPosts] = allPosts;
const morePosts = olderPosts.slice(0, 3);

const allProjects = (await getCollection('projects', isPublished).catch(() => [])).sort(sortByDateDesc);
const featuredProjects = allProjects.slice(0, 3);

const isoDate = (date: string) => new Date(date).toISOString().slice(0, 10);

// The track record, newest first. Each line is a claim the work can back up.
const record = [
  {
    when: 'Now',
    where: 'Oogway Labs',
    href: 'https://oogwaylabs.com/',
    role: 'Founder & CEO',
    what: 'An AI consulting and engineering firm. We build the systems, not the slide deck.',
  },
  {
    when: 'Before',
    where: 'Cornet Health',
    role: 'Co-founder & CTO',
    what: 'Voice-first AI for clinicians, where 95% transcription accuracy turned out to be the easy part.',
  },
  {
    when: 'Before that',
    where: 'Ather Energy',
    role: 'Connected Platforms, Data & AI',
    what: 'Took early experiments to infrastructure behind 500,000+ electric scooters on Indian roads.',
  },
  {
    when: 'Earlier',
    where: 'E-commerce, retail & supply chain',
    role: 'Data science & product',
    what: 'Data platforms that made operational decisions faster and a little less argumentative.',
  },
];

---

<Layout title="Soumyo Dey">
  <!-- Hero: identity in the label column, name and intro from column 4 -->
  <section class="hero" aria-label="Introduction">
    <div class="grid-12 hero-intro">
      <div class="c-label hero-id">
        <div class="hero-avatar">
          <Picture
            src={avatar}
            widths={[80, 160]}
            sizes="80px"
            formats={['avif', 'webp', 'jpeg']}
            alt=""
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="mono">Builder, systems thinker, occasional essayist</p>
      </div>

      <div class="c-body">
        <h1 class="t-display hero-name">Soumyo Dey<span class="hero-stop" aria-hidden="true">.</span></h1>
        <p class="t-lead mt-6 max-w-[40rem] text-[var(--color-text)]">
          A decade of building systems that have to work outside the demo: connected
          platforms for half a million electric scooters, voice AI in clinics, data
          platforms for retail. I write about what held up, and what broke at 3am.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/blog" class="btn btn-primary" data-astro-prefetch>
            Read the writing
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://stochasticmusings.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            Get new essays by email
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]" aria-label="Elsewhere">
          {socials.filter((s) => s.platform !== 'email').map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="link">{social.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Latest essay -->
  {latestPost && (
    <section class="band grid-12 gap-y-4" aria-label="Latest essay">
      <p class="c-label mono">
        Latest essay · <time datetime={isoDate(latestPost.data.date)}>{isoDate(latestPost.data.date)}</time>
      </p>
      <a href={`/blog/${latestPost.id}`} class="latest c-body group" data-astro-prefetch>
        <h2 class="t-title latest-title">{latestPost.data.title}</h2>
        {latestPost.data.subtitle && (
          <p class="t-lead mt-6 max-w-[40rem]">{latestPost.data.subtitle}</p>
        )}
        {latestPost.data.description && (
          <p class="mt-5 max-w-[38rem] text-[var(--color-text-muted)]">{latestPost.data.description}</p>
        )}
        <span class="link mt-8 inline-block">Read it<span aria-hidden="true"> →</span></span>
      </a>
    </section>
  )}

  <!-- Track record: receipts, not metrics -->
  <section class="band" aria-labelledby="record-title">
    <div class="grid-12 gap-y-4">
      <p class="c-label mono sec-num">Record</p>
      <div class="c-body">
        <h2 id="record-title" class="t-heading">Where the work has been</h2>
        <p class="mt-4 max-w-[34rem] text-[var(--color-text-secondary)]">
          Startups and scaled platforms, mostly in places where software meets
          hardware, clinics, or warehouses, and has to behave.
        </p>
      </div>
    </div>

    <ol class="record mt-12">
      {record.map((item) => (
        <li class="record-row">
          <p class="record-when mono">{item.when}</p>
          <h3 class="record-where">
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="link">{item.where}</a>
            ) : (
              item.where
            )}
            <span class="record-role">{item.role}</span>
          </h3>
          <p class="record-what">{item.what}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Built work (only when there are real write-ups to show) -->
  {featuredProjects.length > 0 && (
    <section class="band">
      <div class="grid-12 gap-y-4">
        <p class="c-label mono sec-num">Work</p>
        <h2 class="c-body t-heading">Things I've built</h2>
      </div>
      <div class="mt-12">
        <PostIndex items={featuredProjects.map(toIndexItem)} headers={['Date', 'Project', 'Topics', 'Type']} />
      </div>
      <div class="grid-12 mt-8">
        <p class="c-body"><a href="/projects" class="link" data-astro-prefetch>All work</a></p>
      </div>
    </section>
  )}

  <!-- More writing -->
  {morePosts.length > 0 && (
    <section class="band">
      <div class="grid-12 gap-y-4">
        <p class="c-label mono sec-num">Writing</p>
        <div class="c-body">
          <h2 class="t-heading">More writing</h2>
          <p class="mt-4 max-w-[34rem] text-[var(--color-text-secondary)]">
            On AI systems, product judgment, and the distance between the
            benchmark and the real thing.
          </p>
        </div>
      </div>
      <div class="mt-12">
        <PostIndex items={morePosts.map(toIndexItem)} />
      </div>
      <div class="grid-12 mt-8">
        <p class="c-body"><a href="/blog" class="link" data-astro-prefetch>All essays<span aria-hidden="true"> →</span></a></p>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section id="newsletter-section" class="band grid-12 gap-y-4">
    <p class="c-label mono sec-num">Newsletter</p>
    <div class="c-body">
      <h2 class="t-heading">Stochastic Musings</h2>
      <p class="mt-4 max-w-[34rem] text-[var(--color-text-secondary)]">
        New essays by email, sent when there's something worth saying rather
        than on a schedule. Unsubscribe whenever; no hard feelings.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="https://stochasticmusings.substack.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Subscribe on Substack
        </a>
        <a href="/rss.xml" class="link">or use RSS</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 7vw, 6.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .hero-name {
    margin-left: -0.03em;
    color: var(--color-text);
  }

  /* The one deliberate graphic moment: the full stop in the accent colour */
  .hero-stop {
    color: var(--color-accent);
  }

  .hero-intro {
    row-gap: 2rem;
  }

  /* Phones: portrait and tagline side by side above the name. Wide: the
     portrait heads the label column, top-aligned with the name. */
  .hero-id {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero-id {
      display: grid;
      align-content: start;
      max-width: 14rem;
      padding-top: 0.35rem;
    }
  }

  .hero-avatar {
    flex: none;
    width: 4rem;
    height: 4rem;
    overflow: hidden;
    border: 1px solid var(--color-rule-strong);
  }

  @media (min-width: 48rem) {
    .hero-avatar {
      width: 5rem;
      height: 5rem;
    }
  }

  .latest {
    display: block;
  }

  .latest-title {
    max-width: 17ch;
  }

  .latest:hover .latest-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.12em;
  }

  .latest:hover .link {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
  }

  .record {
    border-top: 1px solid var(--color-rule-strong);
  }

  .record-row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 48rem) {
    .record-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .record-when {
      grid-column: 1 / span 3;
    }

    .record-where {
      grid-column: 4 / span 5;
    }

    .record-what {
      grid-column: 9 / -1;
    }
  }

  .record-when {
    padding-top: 0.3rem;
  }

  .record-where {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .record-role {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .record-what {
    padding-top: 0.2rem;
    color: var(--color-text-secondary);
  }
</style>
