---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ContentListItem from '../components/ContentListItem.astro';
import { socials } from '../config/socials';
import avatar from '../images/avatar.jpg';
import Layout from '../layouts/Layout.astro';
import { formatCardDate, isPublished, readingMinutes, sortByDateDesc, toEntry } from '../utils/content';

const allPosts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
const [latestPost, ...olderPosts] = allPosts;
const morePosts = olderPosts.slice(0, 3);
const latestReadingTime = latestPost ? readingMinutes(latestPost.body) : undefined;

const allProjects = (await getCollection('projects', isPublished).catch(() => [])).sort(sortByDateDesc);
const featuredProjects = allProjects.slice(0, 3);

// The track record, newest first. Each line is a claim the work can back up.
const record = [
  {
    when: 'Now',
    where: 'Oogway Labs',
    href: 'https://oogwaylabs.com/',
    role: 'Founder & CEO',
    what: 'An AI consulting and engineering firm. We build the systems, not the slide deck.',
  },
  {
    when: 'Before',
    where: 'Cornet Health',
    role: 'Co-founder & CTO',
    what: 'Voice-first AI for clinicians, where 95% transcription accuracy turned out to be the easy part.',
  },
  {
    when: 'Before that',
    where: 'Ather Energy',
    role: 'Connected Platforms, Data & AI',
    what: 'Took early experiments to infrastructure behind 500,000+ electric scooters on Indian roads.',
  },
  {
    when: 'Earlier',
    where: 'E-commerce, retail & supply chain',
    role: 'Data science & product',
    what: 'Data platforms that made operational decisions faster and a little less argumentative.',
  },
];
---

<Layout title="Soumyo Dey">
  <!-- Title page: who, in one breath, then straight to the work -->
  <section class="titlepage">
    <div class="titlepage-byline">
      <div class="titlepage-portrait">
        <Picture
          src={avatar}
          widths={[56, 112]}
          sizes="56px"
          formats={['avif', 'webp', 'jpeg']}
          alt=""
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
      <p class="titlepage-tagline">Builder, systems thinker, occasional essayist</p>
    </div>

    <h1 class="titlepage-name">Soumyo Dey</h1>

    <p class="titlepage-lede">
      A decade of building systems that have to work outside the demo: connected
      platforms for half a million electric scooters, voice AI in clinics, data
      platforms for retail. I write about what held up, and what broke at 3am.
    </p>

    <p class="titlepage-actions">
      <a href="/blog" class="btn btn-primary" data-astro-prefetch>
        Read the writing<span aria-hidden="true"> →</span>
      </a>
      <a href="/about" class="link-quiet" data-astro-prefetch>More about me</a>
    </p>
    <ul class="titlepage-elsewhere" aria-label="Elsewhere">
      {socials.filter((s) => s.platform !== 'email').map((social) => (
        <li>
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link-quiet"
          >
            {social.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- The latest essay, set like an opening -->
  {latestPost && (
    <section class="section-break" aria-labelledby="latest-title">
      <a href={`/blog/${latestPost.id}`} class="latest-essay" data-astro-prefetch>
        <p class="latest-essay-label">
          Latest essay · <time datetime={new Date(latestPost.data.date).toISOString()}>{formatCardDate(latestPost.data.date, 'long')}</time>
          {latestReadingTime && <> · {latestReadingTime} min read</>}
        </p>
        <h2 id="latest-title" class="latest-essay-title">{latestPost.data.title}</h2>
        {latestPost.data.subtitle && (
          <p class="latest-essay-dek">{latestPost.data.subtitle}</p>
        )}
        {latestPost.data.description && (
          <p class="latest-essay-blurb">{latestPost.data.description}</p>
        )}
        <span class="latest-essay-more">Read it<span aria-hidden="true"> →</span></span>
      </a>
    </section>
  )}

  <!-- Track record: receipts, not metrics -->
  <section class="section-break" aria-labelledby="record-title">
    <h2 id="record-title" class="section-title">Where the work has been</h2>
    <p class="section-description">
      Startups and scaled platforms, mostly in places where software meets
      hardware, clinics, or warehouses, and has to behave.
    </p>

    <ol class="record">
      {record.map((item) => (
        <li class="record-item">
          <p class="record-when">{item.when}</p>
          <div>
            <h3 class="record-where">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener noreferrer">{item.where}</a>
              ) : (
                item.where
              )}
              <span class="record-role">{item.role}</span>
            </h3>
            <p class="record-what">{item.what}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Built work (only when there are real write-ups to show) -->
  {featuredProjects.length > 0 && (
    <section class="section-break" aria-labelledby="built-title">
      <h2 id="built-title" class="section-title mb-8">Things I've built</h2>

      <div class="entries">
        {featuredProjects.map((project) => <ContentListItem level={3} {...toEntry(project)} />)}
      </div>

      <p class="mt-10">
        <a href="/projects" class="btn btn-secondary" data-astro-prefetch>All work</a>
      </p>
    </section>
  )}

  <!-- More writing -->
  {morePosts.length > 0 && (
    <section class="section-break" aria-labelledby="more-title">
      <div class="more-head">
        <div>
          <h2 id="more-title" class="section-title">More writing</h2>
          <p class="section-description">
            On AI systems, product judgment, and the distance between the
            benchmark and the real thing.
          </p>
        </div>
        <a href="/blog" class="link-quiet" data-astro-prefetch>All essays<span aria-hidden="true"> →</span></a>
      </div>

      <div class="entries mt-10">
        {morePosts.map((post) => <ContentListItem level={3} {...toEntry(post)} />)}
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section id="newsletter-section" class="section-break" aria-labelledby="newsletter-title">
    <h2 id="newsletter-title" class="section-title">Stochastic Musings</h2>
    <p class="mt-4 measure text-[var(--color-text-secondary)]">
      New essays by email, sent when there's something worth saying rather
      than on a schedule. Unsubscribe whenever; no hard feelings.
    </p>
    <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href="https://stochasticmusings.substack.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Subscribe on Substack
      </a>
      <a href="/rss.xml" class="link-quiet">or use RSS</a>
    </p>
  </section>
</Layout>

<style>
  .titlepage {
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
    text-align: center;
  }

  .titlepage-byline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .titlepage-portrait {
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
  }

  .titlepage-tagline {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .titlepage-name {
    margin-top: 1.25rem;
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .titlepage-lede {
    max-width: 34rem;
    margin: 2rem auto 0;
    color: var(--color-text);
    font-size: var(--text-lede);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .titlepage-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
  }

  .titlepage-elsewhere {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.25rem;
    margin-top: 0.75rem;
    font-size: var(--text-small);
  }

  .titlepage-elsewhere li + li::before {
    padding-right: 0.25rem;
    color: var(--color-text-muted);
    content: "·";
  }

  .titlepage-elsewhere a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.25rem;
  }

  .titlepage-elsewhere li {
    display: flex;
    align-items: center;
  }

  .latest-essay {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .latest-essay-label {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-variant-numeric: lining-nums proportional-nums;
  }

  .latest-essay-title {
    margin-top: 0.75rem;
    color: var(--color-text);
    font-size: var(--text-title);
    line-height: 1.1;
  }

  .latest-essay:hover .latest-essay-title {
    color: var(--color-primary);
  }

  .latest-essay:focus-visible {
    outline-offset: 8px;
  }

  .latest-essay-dek {
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: var(--text-lede);
    font-style: italic;
    line-height: 1.4;
  }

  .latest-essay-blurb {
    margin-top: 1rem;
    max-width: var(--measure);
    color: var(--color-text-secondary);
  }

  .latest-essay-more {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .latest-essay:hover .latest-essay-more {
    color: var(--color-primary-hover);
  }

  .more-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .record {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .record-item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 30rem) {
    .record-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }

  .record-when {
    padding-top: 0.2rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .record-where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    font-size: 1.3125rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .record-where a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    text-underline-offset: 0.2em;
  }

  .record-where a:hover {
    color: var(--color-primary);
  }

  .record-role {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    font-weight: 400;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .record-what {
    margin-top: 0.4rem;
    max-width: 40rem;
    color: var(--color-text-secondary);
  }
</style>
