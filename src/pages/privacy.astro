---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy">
  <header class="grid-12 gap-y-4 pb-14 pt-4 md:pb-20">
    <p class="c-label mono">Privacy</p>
    <h1 class="c-body t-title">Privacy Policy</h1>
  </header>

  <div class="grid-12">
    <div class="c-body max-w-[38rem] space-y-10 text-[var(--color-text-secondary)]">
      <p class="t-lead">
        This simplified privacy policy explains how this website handles your information.
      </p>

      <section>
        <h2 class="mb-2 text-xl font-semibold text-[var(--color-text)]">Data Collection</h2>
        <p>
          This website does not collect personal information or track your browsing activity. No
          analytics services are used, and no personal data is processed or stored.
        </p>
      </section>

      <section>
        <h2 class="mb-2 text-xl font-semibold text-[var(--color-text)]">Cookies</h2>
        <p>
          This website uses only essential cookies to remember your preferences (like dark/light
          mode). Some embedded third-party content (such as social media posts or external widgets)
          might set their own cookies when you interact with them.
        </p>
      </section>

      <section>
        <h2 class="mb-2 text-xl font-semibold text-[var(--color-text)]">Contact</h2>
        <p>
          If you have any questions about this privacy policy, you can contact me at
          <a href="mailto:heysoumyo@gmail.com" class="link">heysoumyo@gmail.com</a>.
        </p>
      </section>

      <p class="mono">Last updated: February 2025</p>
    </div>
  </div>
</Layout>
