---



import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { isPublished, readingMinutes, sortByDateDesc } from '../../utils/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
  return posts.map((post, index) => {
    const newer = posts[index - 1];
    const older = posts[index + 1];
    return {
      params: { slug: post.id },
      props: {
        post,
        newer: newer && { href: `/blog/${newer.id}`, title: newer.data.title },
        older: older && { href: `/blog/${older.id}`, title: older.data.title },
      },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const frontmatter = {
  ...post.data,
  readingTime: readingMinutes(post.body),
};
---

<BlogPost frontmatter={frontmatter} headings={headings} newer={newer} older={older}>
  <Content />
</BlogPost>
