---
import { getCollection } from 'astro:content';
import PostIndex from '../components/PostIndex.astro';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toIndexItem } from '../utils/content';

const posts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
---

<Layout title="Writing" description="Essays on AI, data, systems, and product, from someone who ships them.">
  <header class="grid-12 gap-y-4 pb-14 pt-4 md:pb-20">
    <p class="c-label mono sec-num">Writing</p>
    <div class="c-body">
      <h1 class="t-title">Stories from the build log</h1>
      <p class="t-lead mt-6 max-w-[36rem]">
        Reflections on AI, product decisions, and the small stories that shape how we build.
      </p>
    </div>
  </header>

  {
    posts.length > 0 ? (
      <PostIndex items={posts.map(toIndexItem)} showDescription topicLimit={4} />
    ) : (
      <p class="c-body max-w-2xl text-lg text-[var(--color-text-secondary)]">
        New writing is on the way. In the meantime, find me on{' '}
        <a class="link" href="/about">
          the about page
        </a>
        {' '}or follow along on{' '}
        <a
          class="link"
          href="https://stochasticmusings.substack.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          the newsletter
        </a>
        .
      </p>
    )
  }
</Layout>
