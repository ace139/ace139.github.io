---
import { getCollection } from 'astro:content';
import ContentListItem from '../components/ContentListItem.astro';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toEntry } from '../utils/content';

const posts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
---

<Layout title="Writing" description="Essays on AI, data, systems, and product, from someone who ships them.">
  <header class="chapter-head">
    <h1 class="chapter-title">Stories from the build log</h1>
    <p class="chapter-dek">
      Reflections on AI, product decisions, and the small stories that shape how we build.
    </p>
  </header>

  <div class="section-break">
    {
      posts.length > 0 ? (
        <div class="entries">
          {posts.map((post) => (
            <ContentListItem {...toEntry(post)} />
          ))}
        </div>
      ) : (
        <p class="measure text-[var(--color-text-secondary)]">
          New writing is on the way. In the meantime, find me on{' '}
          <a class="link-primary" href="/about">
            the about page
          </a>
          {' '}or follow along on{' '}
          <a
            class="link-primary"
            href="https://stochasticmusings.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            the newsletter
          </a>
          .
        </p>
      )
    }
  </div>
</Layout>
