---



import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toEntry } from '../utils/content';

const posts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
---

<Layout title="Writing" description="Essays on AI, data, systems, and product, from someone who ships them.">
  <header class="row page-head">
    <div class="page-head-body">
      <h1 class="page-title">Stories from the build log</h1>
      <p class="lead">
        Reflections on AI, product decisions, and the small stories that shape how we build.
      </p>
    </div>
  </header>

  {
    posts.length > 0 ? (
      <PostList items={posts.map(toEntry)} />
    ) : (
      <p class="body-serif empty">
        New writing is on the way. In the meantime, find me on{' '}
        <a class="link-primary" href="/about">
          the about page
        </a>
        {' '}or follow along on{' '}
        <a
          class="link-primary"
          href="https://stochasticmusings.substack.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          the newsletter
        </a>
        .
      </p>
    )
  }
</Layout>

<style>
  .empty {
    max-width: 38rem;
  }
</style>
