---

import { getCollection } from 'astro:content';
import ContentListItem from '../components/ContentListItem.astro';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc } from '../utils/content';

const posts = (await getCollection('blog', isPublished)).sort(sortByDateDesc);
---

<Layout title="Writing" description="Essays on AI, data, systems, and product, from someone who ships them.">
  <div class="space-y-12">
    <section class="reveal border-b border-[var(--color-border)] pb-12">
      <h1 class="section-title">Stories from the build log</h1>
      <p class="section-description mt-4 max-w-2xl">
        Reflections on AI, product decisions, and the small stories that shape how we build.
      </p>
    </section>

    {
      posts.length > 0 ? (
        <div class="space-y-0" data-animate-stagger>
          {posts.map((post, index) => (
            <ContentListItem
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              heroImage={post.data.heroImage}
              showDivider={index < posts.length - 1}
              animate
            />
          ))}
        </div>
      ) : (
        <p class="max-w-2xl text-lg text-[var(--color-text-secondary)]">
          New writing is on the way. In the meantime, find me on{' '}
          <a class="link-primary" href="/about">
            the about page
          </a>
          {' '}or follow along on{' '}
          <a
            class="link-primary"
            href="https://stochasticmusings.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            the newsletter
          </a>
          .
        </p>
      )
    }
  </div>
</Layout>