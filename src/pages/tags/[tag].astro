---



import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Layout from '../../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toEntry } from '../../utils/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', isPublished);
  const allProjects = await getCollection('projects', isPublished);

  const allContent = [...allPosts, ...allProjects];

  const uniqueTags = [...new Set(allContent.flatMap((item) => item.data.tags).filter(Boolean))];

  return uniqueTags.map((tag) => {
    const filteredContent = allContent
      .filter((item) => item.data.tags?.includes(tag))
      .sort(sortByDateDesc);
    return {
      params: { tag },
      props: { items: filteredContent },
    };
  });
}

const { tag } = Astro.params;
const { items } = Astro.props;
---

<Layout title={`Tagged “${tag}”`}>
  <header class="row page-head">
    <div class="page-head-body">
      <h1 class="page-title">{tag}</h1>
      <p class="lead">
        {items.length} {items.length === 1 ? 'item' : 'items'} tagged with this topic.
      </p>
    </div>
  </header>

  <PostList items={items.map(toEntry)} />
</Layout>
