---
import { getCollection } from 'astro:content';
import ContentListItem from '../../components/ContentListItem.astro';
import Layout from '../../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toEntry } from '../../utils/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', isPublished);
  const allProjects = await getCollection('projects', isPublished);

  const allContent = [...allPosts, ...allProjects].sort(sortByDateDesc);

  const uniqueTags = [...new Set(allContent.flatMap((item) => item.data.tags).filter(Boolean))];

  return uniqueTags.map((tag) => {
    const filteredContent = allContent.filter((item) => item.data.tags?.includes(tag));
    return {
      params: { tag },
      props: { items: filteredContent },
    };
  });
}

const { tag } = Astro.params;
const { items } = Astro.props;
---

<Layout title={`Tagged “${tag}”`}>
  <header class="chapter-head">
    <h1 class="chapter-title">#{tag}</h1>
    <p class="chapter-dek">
      {items.length} {items.length === 1 ? 'item' : 'items'} tagged with this topic.
    </p>
  </header>

  <div class="section-break">
    <div class="entries">
      {items.map((item) => <ContentListItem {...toEntry(item)} />)}
    </div>
  </div>
</Layout>
