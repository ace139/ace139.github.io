---
import { getCollection } from 'astro:content';
import PostIndex from '../../components/PostIndex.astro';
import Layout from '../../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toIndexItem } from '../../utils/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', isPublished);
  const allProjects = await getCollection('projects', isPublished);

  const allContent = [...allPosts, ...allProjects];

  const uniqueTags = [...new Set(allContent.flatMap((item) => item.data.tags).filter(Boolean))];

  return uniqueTags.map((tag) => {
    const filteredContent = allContent.filter((item) => item.data.tags?.includes(tag)).sort(sortByDateDesc);
    return {
      params: { tag },
      props: { items: filteredContent },
    };
  });
}

const { tag } = Astro.params;
const { items } = Astro.props;

const count = items.length;
const description =
  count === 1
    ? `A single essay or project on ${tag} by Soumyo Dey: “${items[0].data.title}”.`
    : `Essays and projects on ${tag} by Soumyo Dey: ${count} pieces, newest first, starting with “${items[0].data.title}”.`;
---

<Layout title={`Tagged “${tag}”`} description={description} noindex={items.length < 2}>
  <header class="grid-12 gap-y-4 pb-14 pt-4 md:pb-20">
    <p class="c-label mono">Topic</p>
    <div class="c-body">
      <h1 class="t-title">{tag}</h1>
      <p class="t-lead mt-6 max-w-[36rem]">
        {items.length} {items.length === 1 ? 'item' : 'items'} tagged with this topic.
      </p>
    </div>
  </header>

  <PostIndex items={items.map(toIndexItem)} headers={['Date', 'Title', 'Topics', 'Type']} />
</Layout>
