---



import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { isPublished, sortByDateDesc, toEntry } from '../utils/content';

const projects = (await getCollection('projects', isPublished)).sort(sortByDateDesc);
---

<Layout title="Work" description="Things Soumyo Dey has built, with notes on what worked and what broke.">
  <header class="row page-head">
    <div class="page-head-body">
      <h1 class="page-title">Selected Work</h1>
      <p class="lead">
        Experiments, shipping stories, and products that bend AI, strategy, and delightful UI into something useful.
      </p>
    </div>
  </header>

  {
    projects.length > 0 ? (
      <PostList items={projects.map(toEntry)} />
    ) : (
      <div class="row ruled empty">
        <div class="row-body empty-body">
          <p class="body-serif">
            Project write-ups are in progress. For now, the{' '}
            <a class="link-primary" href="/blog">writing</a>
            {' '}covers what I've been building.
          </p>
        </div>
      </div>
    )
  }
</Layout>

<style>
  .empty {
    padding-block: 1.25rem 2rem;
  }

  .empty-body {
    max-width: 38rem;
  }
</style>
