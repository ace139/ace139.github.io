<Layout title="Résumé">
  <header class="chapter-head">
    <h1 class="chapter-title">Soumyo Dey</h1>
    <p class="chapter-dek">Product leader · AI strategist · Storyteller of delightful experiences</p>
    <p class="mt-6">
      <a href="/SoumyoDey_Resume.pdf" class="btn btn-secondary" download>Download PDF</a>
    </p>
  </header>

  <section class="section-break" aria-labelledby="experience-title">
    <h2 id="experience-title" class="section-title">Experience</h2>
    <div class="entries mt-8">
      {
        experience.map((job) => (
          <article class="entry">
            <div class="entry-line">
              <h3 class="entry-title">{job.title}</h3>
              <span class="entry-leader" aria-hidden="true" />
              <p class="entry-meta">{job.period}</p>
            </div>
            <p class="entry-dek">{job.company} · {job.location}</p>
            <p class="mt-2 text-[var(--color-text-secondary)]">{job.description}</p>
            <ul class="topics" aria-label="Skills">
              {job.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-break" aria-labelledby="education-title">
    <h2 id="education-title" class="section-title">Education</h2>
    <div class="entries mt-8">
      {
        education.map((edu) => (
          <article class="entry">
            <div class="entry-line">
              <h3 class="entry-title">{edu.degree}</h3>
              <span class="entry-leader" aria-hidden="true" />
              <p class="entry-meta">{edu.period}</p>
            </div>
            <p class="entry-dek">{edu.school}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-break" aria-labelledby="skills-title">
    <h2 id="skills-title" class="section-title">Skills</h2>
    <ul class="topics mt-6" aria-label="Skills">
      {skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>
</Layout>
