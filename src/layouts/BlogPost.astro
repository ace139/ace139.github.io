---



import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BlogHeader from '../components/BlogHeader.astro';
import Layout from './Layout.astro';

interface AdjacentPost {
  href: string;
  title: string;
}

interface Props {
  frontmatter: CollectionEntry<'blog'>['data'] & { readingTime?: number };
  headings?: MarkdownHeading[];
  newer?: AdjacentPost;
  older?: AdjacentPost;
}

const { frontmatter, headings = [], newer, older } = Astro.props;

// Section list for the margin table of contents (wide screens only).
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= 3;
const readingTime = frontmatter.readingTime || 5;

// 1200×630 social card cropped from the hero image, when the post has one.
const socialImage = frontmatter.heroImage
  ? (await getImage({ src: frontmatter.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : undefined;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description ?? frontmatter.subtitle}
  image={socialImage}
  type="article"
  publishedTime={new Date(frontmatter.date)}
  tags={frontmatter.tags}
>
  <!-- Reading progress: mirrors scroll position through the article -->
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article class="pt-4">
    <BlogHeader
      title={frontmatter.title}
      subtitle={frontmatter.subtitle}
      date={new Date(frontmatter.date)}
      tags={frontmatter.tags}
      readingTime={readingTime}
    />

    <div class="post-body grid-12">
      {showToc && (
        <aside class="post-toc c-label" aria-labelledby="post-toc-title">
          <nav class="post-toc-inner">
            <p id="post-toc-title" class="mono post-toc-title">In this essay</p>
            <ol>
              {sections.map((section) => (
                <li><a href={`#${section.slug}`} data-toc-link={section.slug}>{section.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <!-- Article Content -->
      <div class="c-body">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    <!-- Article Footer -->
    <footer class="post-foot">
      <!-- Subscribe: the moment a reader decides whether to come back -->
      <section class="post-foot-row grid-12 gap-y-4" aria-labelledby="post-subscribe-title">
        <p class="c-label mono">Newsletter</p>
        <div class="c-body">
          <h2 id="post-subscribe-title" class="t-heading">Get the next one by email</h2>
          <p class="mt-4 max-w-[34rem] text-[var(--color-text-secondary)]">
            Stochastic Musings goes out when there's something worth saying,
            not on a schedule.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a
              href="https://stochasticmusings.substack.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Subscribe on Substack
            </a>
            <a href="/rss.xml" class="link">or use RSS</a>
          </div>
        </div>
      </section>

      {(newer || older) && (
        <nav class="post-foot-row grid-12 gap-y-4" aria-label="More essays">
          <p class="c-label mono">Continue</p>
          <div class="c-body post-adjacent-grid">
            {older && (
              <a href={older.href} class="post-adjacent" data-astro-prefetch>
                <span class="mono"><span aria-hidden="true">← </span>Previous essay</span>
                <span class="post-adjacent-title">{older.title}</span>
              </a>
            )}
            {newer && (
              <a href={newer.href} class="post-adjacent post-adjacent-next" data-astro-prefetch>
                <span class="mono">Next essay<span aria-hidden="true"> →</span></span>
                <span class="post-adjacent-title">{newer.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

      <div class="post-foot-row grid-12 gap-y-4">
        <p class="c-label mono">Elsewhere</p>
        <div class="c-body flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
          <a href="/blog" class="link" data-astro-prefetch>All writing</a>

          <!-- Share Section -->
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.9375rem]">
            <span class="text-[var(--color-text-muted)]">Share this essay</span>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(frontmatter.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
              aria-label="Share on Twitter"
            >X</a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
              aria-label="Share on LinkedIn"
            >LinkedIn</a>
          </p>
        </div>
      </div>
    </footer>
  </article>

  <script>
    // Reading progress bar. Drives transform scaleX (off the layout path)
    // from the reader's own scroll position. Mirrors the scrollbar, so it is
    // safe under reduced motion (no autonomous animation).
    let progressEls: { bar: HTMLElement; article: HTMLElement } | null = null;
    let ticking = false;

    function updateReadingProgress() {
      ticking = false;
      if (!progressEls) return;
      const { bar, article } = progressEls;
      const scrollable = article.offsetHeight - window.innerHeight;
      const scrolled = Math.min(
        Math.max(-article.getBoundingClientRect().top, 0),
        Math.max(scrollable, 0),
      );
      const progress = scrollable > 0 ? scrolled / scrollable : 0;
      bar.style.transform = `scaleX(${progress})`;
    }

    function requestReadingProgress() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateReadingProgress);
      }
    }

    function setupReadingProgress() {
      const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
      const article = document.querySelector('article');
      progressEls = bar && article ? { bar, article } : null;
      updateReadingProgress();
    }

    // Window listeners attach once and persist across view transitions; the
    // element references are refreshed on each page load.
    window.addEventListener('scroll', requestReadingProgress, { passive: true });
    window.addEventListener('resize', requestReadingProgress, { passive: true });

    setupReadingProgress();
    document.addEventListener('astro:page-load', setupReadingProgress);

    // Margin TOC: mark the last section heading scrolled past the top third.
    let tocLinks: HTMLAnchorElement[] = [];
    let tocTargets: HTMLElement[] = [];

    function updateTocHighlight() {
      const line = window.innerHeight / 3;
      let current = -1;
      for (const [index, target] of tocTargets.entries()) {
        if (target.getBoundingClientRect().top <= line) current = index;
      }
      for (const [index, link] of tocLinks.entries()) {
        link.toggleAttribute('aria-current', index === current);
      }
    }

    function setupTocHighlight() {
      tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      tocTargets = tocLinks
        .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
        .filter((el): el is HTMLElement => el !== null);
      updateTocHighlight();
    }

    // Attached once; the element lists refresh on each page load.
    window.addEventListener('scroll', () => requestAnimationFrame(updateTocHighlight), { passive: true });

    document.addEventListener('astro:page-load', setupTocHighlight);
  </script>
</Layout>

<style>
  .post-toc {
    display: none;
  }

  /* Margin table of contents: a numbered mono index in columns 1-3, sticky
     beside the reading column. Hidden below 1024px. */
  @media (min-width: 64rem) {
    .post-toc {
      display: block;
    }
  }

  .post-toc-inner {
    position: sticky;
    top: 6.5rem;
    padding-right: 1rem;
  }

  .post-toc-title {
    margin-bottom: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .post-toc ol {
    counter-reset: toc;
  }

  .post-toc li {
    counter-increment: toc;
    border-bottom: 1px solid var(--color-rule);
  }

  .post-toc a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.25rem;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .post-toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .post-toc a:hover {
    color: var(--color-text);
  }

  .post-toc a[aria-current] {
    color: var(--color-text);
    box-shadow: inset 2px 0 0 var(--color-accent);
    padding-left: 0.5rem;
    margin-left: -0.5rem;
  }

  .post-toc a[aria-current]::before {
    color: var(--color-accent);
  }

  .post-body {
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
  }

  .post-foot {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .post-foot-row {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
  }

  .post-foot-row:first-child {
    border-top-color: var(--color-rule-strong);
  }

  .post-adjacent-grid {
    display: grid;
    gap: 0;
  }

  @media (min-width: 40rem) {
    .post-adjacent-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-adjacent {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem 1rem 1.5rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .post-adjacent:hover {
    background: var(--color-row-hover);
  }

  .post-adjacent-next {
    padding-left: 1rem;
    text-align: right;
  }

  .post-adjacent-title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .post-adjacent:hover .post-adjacent-title {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }
</style>
