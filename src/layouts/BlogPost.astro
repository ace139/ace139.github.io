---



import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BlogHeader from '../components/BlogHeader.astro';
import Tags from '../components/Tags.astro';
import Layout from './Layout.astro';

interface AdjacentPost {
  href: string;
  title: string;
}

interface Props {
  frontmatter: CollectionEntry<'blog'>['data'] & { readingTime?: number };
  headings?: MarkdownHeading[];
  newer?: AdjacentPost;
  older?: AdjacentPost;
}

const { frontmatter, headings = [], newer, older } = Astro.props;

// Section list for the margin table of contents (wide screens only).
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= 3;
const readingTime = frontmatter.readingTime || 5;

// 1200×630 social card cropped from the hero image, when the post has one.
const socialImage = frontmatter.heroImage
  ? (await getImage({ src: frontmatter.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : undefined;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description ?? frontmatter.subtitle}
  image={socialImage}
  type="article"
  publishedTime={new Date(frontmatter.date)}
  tags={frontmatter.tags}
>
  <!-- Reading progress: mirrors scroll position through the article -->
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article class="relative mx-auto max-w-3xl pt-4 md:pt-8">
    {showToc && (
      <aside class="post-toc" aria-labelledby="post-toc-title">
        <nav class="post-toc-inner">
          <p id="post-toc-title" class="post-toc-title">In this essay</p>
          <ol>
            {sections.map((section) => (
              <li><a href={`#${section.slug}`} data-toc-link={section.slug}>{section.text}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    )}

    <BlogHeader
      title={frontmatter.title}
      subtitle={frontmatter.subtitle}
      date={new Date(frontmatter.date)}
      heroImage={frontmatter.heroImage}
      heroConfig={frontmatter.heroConfig}
      readingTime={readingTime}
    />

    {
      frontmatter.tags && (
        <div class="mt-6 mb-10">
          <Tags tags={frontmatter.tags} />
        </div>
      )
    }

    <!-- Article Content -->
    <div class="prose-editorial">
      <slot />
    </div>

    <!-- Article Footer -->
    <footer class="mt-20 space-y-16 border-t border-[var(--color-border)]/30 pt-12">
      <!-- Subscribe: the moment a reader decides whether to come back -->
      <section class="post-subscribe" aria-labelledby="post-subscribe-title">
        <h2 id="post-subscribe-title" class="display-heading text-2xl text-[var(--color-text)] sm:text-3xl">
          Get the next one by email
        </h2>
        <p class="mt-3 max-w-xl text-[var(--color-text-secondary)]">
          Stochastic Musings goes out when there's something worth saying,
          not on a schedule.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-6">
          <a
            href="https://stochasticmusings.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Subscribe on Substack
          </a>
          <a href="/rss.xml" class="link-quiet">or use RSS</a>
        </div>
      </section>

      {(newer || older) && (
        <nav class="grid gap-6 sm:grid-cols-2" aria-label="More essays">
          {older && (
            <a href={older.href} class="post-adjacent group" data-astro-prefetch>
              <span class="post-adjacent-label"><span aria-hidden="true">← </span>Previous essay</span>
              <span class="post-adjacent-title">{older.title}</span>
            </a>
          )}
          {newer && (
            <a href={newer.href} class="post-adjacent group sm:col-start-2 sm:text-right" data-astro-prefetch>
              <span class="post-adjacent-label">Next essay<span aria-hidden="true"> →</span></span>
              <span class="post-adjacent-title">{newer.title}</span>
            </a>
          )}
        </nav>
      )}

      <div class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
        <a href="/blog" class="link-quiet" data-astro-prefetch>All writing</a>

        <!-- Share Section -->
        <div class="flex items-center gap-4">
          <span class="text-sm text-[var(--color-text-muted)]">Share this essay</span>
          <div class="flex gap-3">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(frontmatter.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] transition-all hover:border-[var(--color-primary)]/50 hover:text-[var(--color-primary)]"
              aria-label="Share on Twitter"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] transition-all hover:border-[var(--color-primary)]/50 hover:text-[var(--color-primary)]"
              aria-label="Share on LinkedIn"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <script>
    // Reading progress bar. Drives transform scaleX (off the layout path)
    // from the reader's own scroll position. Mirrors the scrollbar, so it is
    // safe under reduced motion (no autonomous animation).
    let progressEls: { bar: HTMLElement; article: HTMLElement } | null = null;
    let ticking = false;

    function updateReadingProgress() {
      ticking = false;
      if (!progressEls) return;
      const { bar, article } = progressEls;
      const scrollable = article.offsetHeight - window.innerHeight;
      const scrolled = Math.min(
        Math.max(-article.getBoundingClientRect().top, 0),
        Math.max(scrollable, 0),
      );
      const progress = scrollable > 0 ? scrolled / scrollable : 0;
      bar.style.transform = `scaleX(${progress})`;
    }

    function requestReadingProgress() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateReadingProgress);
      }
    }

    function setupReadingProgress() {
      const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
      const article = document.querySelector('article');
      progressEls = bar && article ? { bar, article } : null;
      updateReadingProgress();
    }

    // Window listeners attach once and persist across view transitions; the
    // element references are refreshed on each page load.
    window.addEventListener('scroll', requestReadingProgress, { passive: true });
    window.addEventListener('resize', requestReadingProgress, { passive: true });

    setupReadingProgress();
    document.addEventListener('astro:page-load', setupReadingProgress);

    // Margin TOC: mark the last section heading scrolled past the top third.
    let tocLinks: HTMLAnchorElement[] = [];
    let tocTargets: HTMLElement[] = [];

    function updateTocHighlight() {
      const line = window.innerHeight / 3;
      let current = -1;
      for (const [index, target] of tocTargets.entries()) {
        if (target.getBoundingClientRect().top <= line) current = index;
      }
      for (const [index, link] of tocLinks.entries()) {
        link.toggleAttribute('aria-current', index === current);
      }
    }

    function setupTocHighlight() {
      tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      tocTargets = tocLinks
        .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
        .filter((el): el is HTMLElement => el !== null);
      updateTocHighlight();
    }

    // Attached once; the element lists refresh on each page load.
    window.addEventListener('scroll', () => requestAnimationFrame(updateTocHighlight), { passive: true });

    document.addEventListener('astro:page-load', setupTocHighlight);
  </script>
</Layout>

<style>
  /* Margin table of contents: sits in the right gutter on wide screens so the
     reading column stays centred; hidden below that. */
  .post-toc {
    display: none;
  }

  @media (min-width: 80rem) {
    .post-toc {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 100%;
      width: 11rem;
      margin-left: 3rem;
    }
  }

  .post-toc-inner {
    position: sticky;
    top: 7rem;
  }

  .post-toc-title {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .post-toc ol {
    display: grid;
    gap: 0.625rem;
    border-left: 1px solid var(--color-border);
  }

  .post-toc a {
    display: block;
    margin-left: -1px;
    padding-left: 0.875rem;
    border-left: 1px solid transparent;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .post-toc a:hover {
    color: var(--color-text);
  }

  .post-toc a[aria-current] {
    color: var(--color-text);
    border-left-color: var(--color-primary);
  }

  .post-adjacent {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out-quint);
  }

  .post-adjacent:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
  }

  .post-adjacent-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-adjacent-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-text);
    text-wrap: balance;
  }

  .post-adjacent:hover .post-adjacent-title {
    color: var(--color-primary);
  }

  /* Editorial prose styling - optimized for reading.
     Roboto Slab is the reading body per DESIGN.md; headings below switch to
     the sans face for structural contrast. */
  .prose-editorial {
    color: var(--color-text-secondary-dark);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .prose-editorial > :global(* + *) {
    margin-top: 1.5em;
  }

  /* Headings */
  .prose-editorial :global(h1),
  .prose-editorial :global(h2),
  .prose-editorial :global(h3),
  .prose-editorial :global(h4) {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-text-dark);
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    line-height: 1.3;
    text-wrap: balance;
    /* Clear the fixed nav when jumping from the table of contents. */
    scroll-margin-top: 6rem;
  }

  .prose-editorial :global(h1) { font-size: 2.25rem; }
  .prose-editorial :global(h2) { font-size: 1.75rem; }
  .prose-editorial :global(h3) { font-size: 1.375rem; }
  .prose-editorial :global(h4) { font-size: 1.125rem; }

  /* Links */
  .prose-editorial :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(244, 63, 94, 0.35);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }

  .prose-editorial :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  /* Strong and emphasis */
  .prose-editorial :global(strong) {
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .prose-editorial :global(em) {
    font-style: italic;
  }

  /* Blockquotes */
  .prose-editorial :global(blockquote) {
    position: relative;
    margin: 2rem 0;
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-dark);
    padding: 1.5rem;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    hanging-punctuation: first;
  }

  .prose-editorial :global(blockquote p) {
    color: var(--color-text-dark);
    margin: 0;
  }

  /* Code */
  .prose-editorial :global(code) {
    background: var(--color-surface-dark);
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-coral);
  }

  .prose-editorial :global(pre) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-surface-dark);
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  .prose-editorial :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--color-text-secondary-dark);
  }

  /* Lists */
  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .prose-editorial :global(ul) { list-style-type: disc; }
  .prose-editorial :global(ol) { list-style-type: decimal; }

  .prose-editorial :global(li) {
    margin: 0.5rem 0;
  }

  .prose-editorial :global(li::marker) {
    color: var(--color-accent);
  }

  /* Tables: scroll sideways on narrow screens instead of squashing */
  .prose-editorial :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .prose-editorial :global(th),
  .prose-editorial :global(td) {
    padding: 0.625rem 1rem 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prose-editorial :global(th) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Images */
  .prose-editorial :global(img) {
    margin: 2rem 0;
    border-radius: 0.75rem;
  }

  /* Horizontal rule */
  .prose-editorial :global(hr) {
    margin: 3rem 0;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Embedded content (YouTube, etc.) */
  .prose-editorial :global(iframe) {
    margin: 2rem 0;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 0.75rem;
  }

  /* Light mode overrides */
  :global(html.light) .prose-editorial {
    color: var(--color-text-secondary-light);
  }

  :global(html.light) .prose-editorial :global(h1),
  :global(html.light) .prose-editorial :global(h2),
  :global(html.light) .prose-editorial :global(h3),
  :global(html.light) .prose-editorial :global(h4),
  :global(html.light) .prose-editorial :global(strong) {
    color: var(--color-text-light);
  }

  :global(html.light) .prose-editorial :global(a) {
    color: var(--color-primary-light);
  }

  :global(html.light) .prose-editorial :global(blockquote) {
    border-color: var(--color-primary-light);
    background: var(--color-surface-light);
  }

  :global(html.light) .prose-editorial :global(blockquote p) {
    color: var(--color-text-light);
  }

  :global(html.light) .prose-editorial :global(code) {
    background: var(--color-surface-light);
    color: var(--color-primary-light);
  }

  :global(html.light) .prose-editorial :global(pre) {
    background: var(--color-surface-light);
  }

  :global(html.light) .prose-editorial :global(li::marker) {
    color: var(--color-primary-light);
  }
</style>
