---
import { getImage } from 'astro:assets';
import Tags from '../components/Tags.astro';
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const socialImage = frontmatter.heroImage
  ? (await getImage({ src: frontmatter.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : undefined;
const isoDate = new Date(frontmatter.date).toISOString().slice(0, 10);
---

<Layout title={frontmatter.title} description={frontmatter.description} image={socialImage}>
  <article class="pt-4">
    <header class="pb-12">
      <dl class="grid-12 gap-y-4 border-y border-[var(--color-rule)] py-4">
        <div class="c-label">
          <dt class="mono">Published</dt>
          <dd class="mono text-[var(--color-text)]"><time datetime={isoDate}>{isoDate}</time></dd>
        </div>
        {frontmatter.tags && (
          <div class="c-body">
            <dt class="mono">Topics</dt>
            <dd><Tags tags={frontmatter.tags} /></dd>
          </div>
        )}
      </dl>

      <div class="grid-12 gap-y-6 pt-12">
        <h1 class="c-body t-title">{frontmatter.title}</h1>
        <p class="c-body t-lead max-w-[40rem]">{frontmatter.description}</p>

        {(frontmatter.github || frontmatter.demo) && (
          <p class="c-body flex flex-wrap gap-x-8 gap-y-2">
            {frontmatter.github && (
              <a href={frontmatter.github} class="link" target="_blank" rel="noopener noreferrer">GitHub repository</a>
            )}
            {frontmatter.demo && (
              <a href={frontmatter.demo} class="link" target="_blank" rel="noopener noreferrer">Live demo</a>
            )}
          </p>
        )}
      </div>
    </header>

    <div class="grid-12 border-t border-[var(--color-rule)] pt-8">
      <div class="c-body">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    <div class="grid-12 mt-16 border-t border-[var(--color-rule)] pt-8">
      <p class="c-body"><a href="/projects" class="link">Back to Projects</a></p>
    </div>
  </article>
</Layout>
