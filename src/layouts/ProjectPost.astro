---



import { getImage } from 'astro:assets';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Tags from '../components/Tags.astro';
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const socialImage = frontmatter.heroImage
  ? (await getImage({ src: frontmatter.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : undefined;
---

<Layout title={frontmatter.title} description={frontmatter.description} image={socialImage}>
  <article>
    <header class="row page-head">
      <div class="marginalia project-meta">
        {frontmatter.tags && frontmatter.tags.length > 0 && <Tags tags={frontmatter.tags} />}
      </div>
      <div class="project-titles">
        <h1 class="page-title">{frontmatter.title}</h1>
        <p class="lead">{frontmatter.description}</p>
        {
          (frontmatter.github || frontmatter.demo) && (
            <p class="project-links">
              {frontmatter.github && (
                <a href={frontmatter.github} class="link-quiet" target="_blank" rel="noopener noreferrer">
                  GitHub Repository
                </a>
              )}
              {frontmatter.demo && (
                <a href={frontmatter.demo} class="link-quiet" target="_blank" rel="noopener noreferrer">
                  Live Demo
                </a>
              )}
            </p>
          )
        }
      </div>
    </header>

    {
      frontmatter.heroImage && (
        <div class="row">
          <ResponsiveImage
            src={frontmatter.heroImage}
            alt={frontmatter.title}
            class="project-hero row-body"
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 1152px) 880px, 100vw"
          />
        </div>
      )
    }

    <div class="row project-body">
      <div class="prose row-body">
        <slot />
      </div>
    </div>

    <div class="row ruled project-back">
      <p class="row-body">
        <a href="/projects" class="link-quiet" data-astro-prefetch><span aria-hidden="true">← </span>Back to Projects</a>
      </p>
    </div>
  </article>
</Layout>

<style>
  .project-titles {
    max-width: 44rem;
  }

  .project-titles .lead {
    margin-top: 1.25rem;
    max-width: 36rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }

  .project-meta {
    padding-top: 0.75rem;
  }

  .project-hero {
    overflow: hidden;
    border-radius: 4px;
  }

  .project-body {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .project-back {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 1.5rem;
  }
</style>
