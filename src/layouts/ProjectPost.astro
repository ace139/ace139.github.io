---
import { getImage } from 'astro:assets';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Tags from '../components/Tags.astro';
import { formatCardDate } from '../utils/content';
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const socialImage = frontmatter.heroImage
  ? (await getImage({ src: frontmatter.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src
  : undefined;
---

<Layout title={frontmatter.title} description={frontmatter.description} image={socialImage}>
  <article>
    <header class="chapter-head">
      <h1 class="chapter-title">{frontmatter.title}</h1>
      <p class="chapter-dek">{frontmatter.description}</p>
      <p class="chapter-meta">
        <time datetime={new Date(frontmatter.date).toISOString()}>{formatCardDate(frontmatter.date, 'long')}</time>
        {frontmatter.github && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <a href={frontmatter.github} target="_blank" rel="noopener noreferrer">GitHub Repository</a>
          </>
        )}
        {frontmatter.demo && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <a href={frontmatter.demo} target="_blank" rel="noopener noreferrer">Live Demo</a>
          </>
        )}
      </p>
      {frontmatter.tags && <Tags tags={frontmatter.tags} class="justify-center" />}
    </header>

    {
      frontmatter.heroImage && (
        <figure class="plate">
          <div class="plate-frame">
            <ResponsiveImage
              src={frontmatter.heroImage}
              alt={frontmatter.title}
              class="h-full w-full"
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 768px) 736px, 100vw"
            />
          </div>
        </figure>
      )
    }

    <div class="prose section-break dropcap">
      <slot />
    </div>

    <footer class="section-break">
      <a href="/projects" class="link-quiet" data-astro-prefetch>
        <span aria-hidden="true">← </span>Back to Projects
      </a>
    </footer>
  </article>
</Layout>

<style>
  .plate {
    margin-top: 2.5rem;
  }

  .plate-frame {
    aspect-ratio: 16 / 9;
    max-height: 26rem;
    width: 100%;
    overflow: hidden;
  }
</style>
