---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import PostHog from '../components/posthog.astro';
import ScriptOptimizer from '../components/ScriptOptimizer.astro';
import avatar from '../images/avatar.jpg';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  /** Social card image (absolute or root-relative URL). */
  image?: string;
  /** Open Graph type: `article` adds publish date and tags. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  analytics?: boolean;
  substack?: boolean;
  socialEmbed?: boolean;
}

const {
  title,
  description = 'Soumyo Dey builds products across AI, data, and systems, and writes about what holds up in production.',
  image,
  type = 'website',
  publishedTime,
  tags = [],
  analytics = false,
  substack = false,
  socialEmbed = false,
} = Astro.props;

// Generate optimized image for preloading on homepage
const preloadImage = Astro.url.pathname === '/' ? await getImage({
  src: avatar,
  width: 128,
  format: 'webp'
}) : null;

const siteName = 'Soumyo Dey';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageSrc =
  image ?? (await getImage({ src: avatar, width: 512, height: 512, format: 'jpeg' })).src;
const ogImage = new URL(ogImageSrc, Astro.site);
const isLargeCard = Boolean(image);

const personSchema = {
  '@type': 'Person',
  name: siteName,
  url: Astro.site?.href,
  sameAs: ['https://x.com/soumyo', 'https://linkedin.com/in/soumyo-dey', 'https://github.com/ace139'],
};
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.href,
        datePublished: publishedTime?.toISOString(),
        author: personSchema,
        mainEntityOfPage: canonicalURL.href,
        keywords: tags.join(', ') || undefined,
      }
    : { '@context': 'https://schema.org', ...personSchema };

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafbfc" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Soumyo Dey: writing" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Social cards -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={isLargeCard ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@soumyo" />
    <meta name="twitter:creator" content="@soumyo" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Self-hosted variable fonts with size-adjusted fallbacks (no layout shift on swap) -->
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-playfair" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-roboto-slab" />

    <!-- Theme initialization (dark mode default, prevents FOUC) -->
    <script is:inline>
      (() => {
        function getTheme() {
          // Check localStorage first
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          // Default to dark mode (Editorial Noir)
          return 'dark';
        }

        function applyTheme() {
          const theme = getTheme();
          const html = document.documentElement;

          // Remove both classes first
          html.classList.remove('light', 'dark');

          // Add the appropriate class (we use 'light' class for light mode,
          // default/no class or 'dark' class for dark mode)
          if (theme === 'light') {
            html.classList.add('light');
          }
          // Dark is default, no class needed but we add it for consistency
        }

        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- Motion readiness (set pre-paint so reveal initial-states never flash,
         and are never applied for reduced-motion users) -->
    <script is:inline>
      (() => {
        const allowsMotion =
          typeof matchMedia === 'undefined' ||
          !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (allowsMotion) {
          document.documentElement.classList.add('motion-ok');
        }
      })();
    </script>

    <!-- Critical inline styles -->
    <style is:inline>
      :root {
        color-scheme: dark light;
      }
      body {
        margin: 0;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      /* Prevent FOUC */
      html:not(.light) body {
        background: #0a0d14;
        color: #f0f2f7;
      }
      html.light body {
        background: #fafbfc;
        color: #111827;
      }
    </style>

    <!-- Preload profile image on homepage -->
    {preloadImage && (
      <link
        rel="preload"
        fetchpriority="high"
        as="image"
        type="image/webp"
        href={preloadImage.src}
      />
    )}

    <ScriptOptimizer analytics={analytics} substack={substack} socialEmbed={socialEmbed} />
    <PostHog />
    <ClientRouter />
  </head>

  <body class="min-h-screen bg-[var(--color-bg-dark)] font-sans text-[var(--color-text-dark)] antialiased transition-colors duration-300">
    <!-- Skip to content (first focusable element) -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Ambient light: one static gradient layer, no blur filters to repaint -->
    <div class="ambient-light pointer-events-none fixed inset-0 z-0" data-ambient aria-hidden="true"></div>

    <Navigation navLinks={navLinks} />

    <!-- Main Content -->
    <main id="main-content" tabindex="-1" class="relative z-10 focus:outline-none">
      <div class="mx-auto max-w-6xl px-4 pt-24 pb-16 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>

    <Footer navLinks={navLinks} />

    <!-- Scripts -->
    <script>
      // Mobile menu toggle: keeps aria-expanded, icons, and visibility in sync,
      // closes on Escape (returning focus) and on link selection.
      function setMenuState(toggle: HTMLElement, menu: HTMLElement, open: boolean) {
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        const openIcon = toggle.querySelector('#menu-icon-open');
        const closeIcon = toggle.querySelector('#menu-icon-close');
        if (openIcon && closeIcon) {
          openIcon.classList.toggle('hidden', open);
          closeIcon.classList.toggle('hidden', !open);
        }
      }

      function setupMobileMenu() {
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!menuToggle || !mobileMenu) return;

        // Reset listeners by cloning (handles re-init across View Transitions)
        const toggle = menuToggle.cloneNode(true) as HTMLElement;
        menuToggle.parentNode?.replaceChild(toggle, menuToggle);

        // Normalize to a known closed state on each (re)init
        setMenuState(toggle, mobileMenu, false);

        toggle.addEventListener('click', () => {
          const willOpen = mobileMenu.classList.contains('hidden');
          setMenuState(toggle, mobileMenu, willOpen);
        });

        // Selecting a destination closes the menu
        for (const link of mobileMenu.querySelectorAll('a')) {
          link.addEventListener('click', () => setMenuState(toggle, mobileMenu, false));
        }
      }

      // Escape closes the open menu and returns focus to the toggle.
      // Attached once; resolves the current elements on each keypress.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const toggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        if (toggle && mobileMenu && !mobileMenu.classList.contains('hidden')) {
          setMenuState(toggle, mobileMenu, false);
          toggle.focus();
        }
      });

      setupMobileMenu();
      document.addEventListener('astro:page-load', setupMobileMenu);
    </script>

    <script>
      // Theme toggle logic
      function setupThemeToggle() {
        const themeToggle = document.getElementById('theme-toggle');
        const darkIcon = document.getElementById('theme-icon-dark');
        const lightIcon = document.getElementById('theme-icon-light');

        function updateIcons() {
          const isLight = document.documentElement.classList.contains('light');
          if (darkIcon && lightIcon) {
            if (isLight) {
              darkIcon.classList.add('hidden');
              lightIcon.classList.remove('hidden');
            } else {
              darkIcon.classList.remove('hidden');
              lightIcon.classList.add('hidden');
            }
          }
        }

        // Initial icon state
        updateIcons();

        if (themeToggle) {
          const newToggle = themeToggle.cloneNode(true) as HTMLElement;
          themeToggle.parentNode?.replaceChild(newToggle, themeToggle);

          newToggle.addEventListener('click', () => {
            const html = document.documentElement;
            const isCurrentlyLight = html.classList.contains('light');

            if (isCurrentlyLight) {
              html.classList.remove('light');
              localStorage.setItem('theme', 'dark');
            } else {
              html.classList.add('light');
              localStorage.setItem('theme', 'light');
            }

            // Update icons after toggle
            const updatedDarkIcon = newToggle.querySelector('#theme-icon-dark');
            const updatedLightIcon = newToggle.querySelector('#theme-icon-light');

            if (updatedDarkIcon && updatedLightIcon) {
              if (html.classList.contains('light')) {
                updatedDarkIcon.classList.add('hidden');
                updatedLightIcon.classList.remove('hidden');
              } else {
                updatedDarkIcon.classList.remove('hidden');
                updatedLightIcon.classList.add('hidden');
              }
            }
          });
        }
      }

      setupThemeToggle();
      document.addEventListener('astro:page-load', setupThemeToggle);
    </script>

    <script>
      // Scroll reveal. Elements are visible by default; html.motion-ok (set
      // pre-paint, never under reduced motion) arms the hidden initial state in
      // CSS, and this observer releases it. Stagger groups get per-item delays.
      function setupScrollReveal() {
        if (!document.documentElement.classList.contains('motion-ok')) return;

        for (const group of document.querySelectorAll<HTMLElement>('[data-animate-stagger]')) {
          group.querySelectorAll<HTMLElement>('[data-animate-item]').forEach((item, index) => {
            item.style.setProperty('--reveal-delay', `${index * 120}ms`);
            item.classList.add('reveal');
          });
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        for (const el of document.querySelectorAll('.reveal:not(.reveal-visible)')) {
          observer.observe(el);
        }
      }

      // Fires on the initial load and after every view transition.
      document.addEventListener('astro:page-load', setupScrollReveal);
    </script>
  </body>
</html>

<style is:global>
  /* Nav backdrop - dark mode default */
  #nav-backdrop {
    background: linear-gradient(180deg, rgba(10, 13, 20, 0.95) 0%, rgba(10, 13, 20, 0.8) 100%);
  }

  /* Light mode body overrides */
  html.light body {
    background: var(--color-bg-light);
    color: var(--color-text-light);
  }

  /* Light mode nav */
  html.light #main-nav {
    border-color: var(--color-border-light);
  }

  html.light #nav-backdrop {
    background: linear-gradient(180deg, rgba(250, 251, 252, 0.95) 0%, rgba(250, 251, 252, 0.8) 100%);
  }

  html.light #main-nav a {
    color: var(--color-muted-light);
  }

  html.light #main-nav a:hover {
    color: var(--color-text-light);
  }

  html.light #main-nav a[href="/"] {
    color: var(--color-text-light);
  }

  html.light #main-nav a[href="/"]:hover {
    color: var(--color-primary-light);
  }

  html.light #theme-toggle,
  html.light #menu-toggle {
    border-color: var(--color-border-light);
    color: var(--color-muted-light);
  }

  html.light #theme-toggle:hover,
  html.light #menu-toggle:hover {
    border-color: var(--color-primary-light);
    color: var(--color-primary-light);
  }

  /* Light mode ambient glow - more subtle */
  html.light .ambient-light {
    opacity: 0.25;
  }

  /* Light mode footer */
  html.light footer {
    border-color: var(--color-border-light);
  }

  html.light footer p {
    color: var(--color-text-secondary-light);
  }

  /* biome-ignore lint/style/noDescendingSpecificity: footer links are disjoint from the higher-specificity #main-nav link rules above — no real cascade conflict */
  html.light footer a {
    color: var(--color-text-secondary-light);
  }

  /* biome-ignore lint/style/noDescendingSpecificity: footer links are disjoint from the higher-specificity #main-nav link rules above — no real cascade conflict */
  html.light footer a:hover {
    color: var(--color-primary-light);
  }

  html.light footer .text-xs.uppercase {
    color: var(--color-muted-light);
  }
</style>
