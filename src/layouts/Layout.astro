---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import PostHog from '../components/posthog.astro';
import ScriptOptimizer from '../components/ScriptOptimizer.astro';
import avatar from '../images/avatar.jpg';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  /** Social card image (absolute or root-relative URL). */
  image?: string;
  /** Open Graph type: `article` adds publish date and tags. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  analytics?: boolean;
  substack?: boolean;
  socialEmbed?: boolean;
}

const {
  title,
  description = 'Soumyo Dey builds products across AI, data, and systems, and writes about what holds up in production.',
  image,
  type = 'website',
  publishedTime,
  tags = [],
  analytics = false,
  substack = false,
  socialEmbed = false,
} = Astro.props;

// Generate optimized image for preloading on homepage
const preloadImage = Astro.url.pathname === '/' ? await getImage({
  src: avatar,
  width: 128,
  format: 'webp'
}) : null;

const siteName = 'Soumyo Dey';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageSrc =
  image ?? (await getImage({ src: avatar, width: 512, height: 512, format: 'jpeg' })).src;
const ogImage = new URL(ogImageSrc, Astro.site);
const isLargeCard = Boolean(image);

const personSchema = {
  '@type': 'Person',
  name: siteName,
  url: Astro.site?.href,
  sameAs: ['https://x.com/soumyo', 'https://linkedin.com/in/soumyo-dey', 'https://github.com/ace139'],
};
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.href,
        datePublished: publishedTime?.toISOString(),
        author: personSchema,
        mainEntityOfPage: canonicalURL.href,
        keywords: tags.join(', ') || undefined,
      }
    : { '@context': 'https://schema.org', ...personSchema };

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c1b1a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Soumyo Dey: writing" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Social cards -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={isLargeCard ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@soumyo" />
    <meta name="twitter:creator" content="@soumyo" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Self-hosted variable font (roman + italic) with a size-adjusted fallback (no layout shift on swap) -->
    <Font cssVariable="--font-source-serif" preload />

    <!-- Theme initialization (follows the system preference until the reader
         chooses; runs before first paint so there is no flash) -->
    <script is:inline>
      (() => {
        const systemDark = matchMedia('(prefers-color-scheme: dark)');
        const chrome = { light: '#fbfbfa', dark: '#1c1b1a' };

        function storedTheme() {
          try {
            const value = localStorage.getItem('theme');
            return value === 'light' || value === 'dark' ? value : null;
          } catch {
            return null;
          }
        }

        function applyTheme() {
          const theme = storedTheme() ?? (systemDark.matches ? 'dark' : 'light');
          const root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.setAttribute('content', chrome[theme]);
          }
          document.dispatchEvent(new Event('theme-applied'));
        }

        applyTheme();
        systemDark.addEventListener('change', applyTheme);
        document.addEventListener('theme-change', applyTheme);
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- Motion readiness (set pre-paint; never set for reduced-motion users, so
         transitions gated on it never run for them) -->
    <script is:inline>
      (() => {
        function markMotion() {
          const allowsMotion =
            typeof matchMedia === 'undefined' ||
            !matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (allowsMotion) {
            document.documentElement.classList.add('motion-ok');
          }
        }
        markMotion();
        // View transitions replace the <html> attributes; restore the flag.
        document.addEventListener('astro:after-swap', markMotion);
      })();
    </script>

    <!-- Critical inline styles: mirror --color-bg / --color-text so first paint matches the theme -->
    <style is:inline>
      :root {
        color-scheme: light dark;
      }
      :root.light {
        color-scheme: light;
      }
      :root.dark {
        color-scheme: dark;
      }
      body {
        margin: 0;
        background: light-dark(#fbfbfa, #1c1b1a);
        color: light-dark(#18181b, #ebe9e5);
        text-rendering: optimizeLegibility;
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>

    <!-- Preload profile image on homepage -->
    {preloadImage && (
      <link
        rel="preload"
        fetchpriority="high"
        as="image"
        type="image/webp"
        href={preloadImage.src}
      />
    )}

    <ScriptOptimizer analytics={analytics} substack={substack} socialEmbed={socialEmbed} />
    <PostHog />
    <ClientRouter />
  </head>

  <body>
    <!-- Skip to content (first focusable element) -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Navigation navLinks={navLinks} />

    <!-- Main Content -->
    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <div class="page">
        <slot />
      </div>
    </main>

    <Footer navLinks={navLinks} />

    <!-- Scripts -->
    <script>
      // Theme toggle: the icon shows the current theme; a click pins the
      // other one in localStorage and asks the inline script to apply it.
      function updateThemeIcons() {
        const isLight = document.documentElement.classList.contains('light');
        document.getElementById('theme-icon-dark')?.classList.toggle('hidden', isLight);
        document.getElementById('theme-icon-light')?.classList.toggle('hidden', !isLight);
      }

      function setupThemeToggle() {
        updateThemeIcons();
        const themeToggle = document.getElementById('theme-toggle');
        if (!themeToggle) return;

        // Reset listeners by cloning (handles re-init across View Transitions)
        const toggle = themeToggle.cloneNode(true) as HTMLElement;
        themeToggle.parentNode?.replaceChild(toggle, themeToggle);

        toggle.addEventListener('click', () => {
          const next = document.documentElement.classList.contains('light') ? 'dark' : 'light';
          try {
            localStorage.setItem('theme', next);
          } catch {
            // Storage blocked: the choice still applies for this page view.
            document.documentElement.classList.remove('light', 'dark');
            document.documentElement.classList.add(next);
            updateThemeIcons();
            return;
          }
          document.dispatchEvent(new Event('theme-change'));
        });
      }

      document.addEventListener('theme-applied', updateThemeIcons);
      setupThemeToggle();
      document.addEventListener('astro:page-load', setupThemeToggle);
    </script>
  </body>
</html>
