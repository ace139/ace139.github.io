---
import { socials } from '../config/socials';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;
---

<!-- Colophon: who made it, where to go next, how it was set. -->
<footer class="colophon">
  <div class="page">
    <p class="measure italic text-[var(--color-text)]">
      Building systems that hold up outside the demo, and writing about the ones that didn't.
    </p>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      <nav aria-label="Pages">
        <p class="colophon-label">Pages</p>
        <ul class="colophon-list">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </nav>

      <div>
        <p class="colophon-label">Elsewhere</p>
        <ul class="colophon-list">
          <li><a href="mailto:heysoumyo@gmail.com">heysoumyo@gmail.com</a></li>
          {socials.filter((social) => social.platform !== 'email').map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="colophon-set">
      Set in Source Serif 4, with real small caps and old-style figures.
    </p>
    <p class="mt-2 text-[var(--color-text-muted)]">
      &copy; {new Date().getFullYear()} Soumyo Dey &middot; <a href="/privacy">Privacy</a>
    </p>
  </div>
</footer>
