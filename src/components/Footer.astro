---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;
---

<footer>
  <div class="shell">
    <div class="row ruled footer-row">
      <p class="footer-name">Soumyo Dey</p>

      <div class="footer-cols">
        <p class="footer-blurb">
          Building systems that hold up outside the demo, and writing about the ones that didn't.
        </p>

        <div>
          <p class="footer-label">Pages</p>
          <ul>
            {navLinks.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
            <li><a href="/rss.xml" class="footer-link">RSS feed</a></li>
          </ul>
        </div>

        <div>
          <p class="footer-label">Elsewhere</p>
          <ul>
            <li><a href="mailto:heysoumyo@gmail.com" class="footer-link">heysoumyo@gmail.com</a></li>
          </ul>
          <div class="footer-icons">
            <a href="https://x.com/soumyo" class="footer-icon" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://linkedin.com/in/soumyo-dey" class="footer-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com/ace139" class="footer-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <p class="row ruled footer-legal marginalia">
      <span class="footer-legal-text">
        &copy; {new Date().getFullYear()} Soumyo Dey &middot; <a href="/privacy" class="footer-legal-link">Privacy</a>
      </span>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: 2.5rem;
  }

  .footer-row {
    padding-block: 1.25rem 3rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
  }

  .footer-cols {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 40rem) {
    .footer-cols {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .footer-blurb {
    max-width: 24rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .footer-label {
    margin-bottom: 0.5rem;
    font-size: var(--text-note);
    color: var(--color-text-muted);
  }

  .footer-cols ul {
    display: grid;
    gap: 0.125rem;
  }

  .footer-link {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: var(--text-ui);
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
  }

  .footer-link:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
  }

  .footer-icons {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.5rem;
    margin-left: -0.5rem;
  }

  .footer-icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  .footer-icon:hover {
    color: var(--color-text);
  }

  .footer-legal {
    padding-top: 1rem;
  }

  .footer-legal-text {
    grid-column: 1 / -1;
  }

  .footer-legal-link {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
