---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid-12 gap-y-10">
      <!-- Brand: columns 1-3 -->
      <p class="c-label text-[1.0625rem] font-bold tracking-[-0.035em]">Soumyo Dey</p>

      <p class="max-w-[24rem] text-[var(--color-text-secondary)] md:col-[4/9]">
        Building systems that hold up outside the demo, and writing about the ones that didn't.
      </p>

      <nav aria-label="Pages" class="md:col-[9/11] md:row-start-1">
        <p class="mono mb-3">Pages</p>
        <ul class="footer-list">
          {navLinks.map((link) => (
            <li><a href={link.href} class="link">{link.label}</a></li>
          ))}
          <li><a href="/rss.xml" class="link">RSS feed</a></li>
        </ul>
      </nav>

      <div class="md:col-[11/13] md:row-start-1">
        <p class="mono mb-3">Elsewhere</p>
        <ul class="footer-list">
          <li><a href="mailto:heysoumyo@gmail.com" class="link">heysoumyo@gmail.com</a></li>
          <li><a href="https://x.com/soumyo" target="_blank" rel="noopener noreferrer" class="link">X (Twitter)</a></li>
          <li><a href="https://linkedin.com/in/soumyo-dey" target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a></li>
          <li><a href="https://github.com/ace139" target="_blank" rel="noopener noreferrer" class="link">GitHub</a></li>
        </ul>
      </div>
    </div>

    <p class="mono mt-16 border-t border-[var(--color-rule)] pt-5">
      &copy; {new Date().getFullYear()} Soumyo Dey &middot; <a href="/privacy" class="link">Privacy</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule-strong);
    padding-block: 4rem 2rem;
    font-size: 0.9375rem;
  }

  .footer-list {
    display: grid;
    gap: 0.5rem;
  }
</style>
