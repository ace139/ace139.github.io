---
import { type EntryProps, formatCardDate } from "../utils/content";
import Tags from "./Tags.astro";

interface Props extends EntryProps {
	/** Heading level: 2 on pages whose title is the h1, 3 under a section h2. */
	level?: 2 | 3;
}

const {
	href,
	title,
	description,
	date,
	tags = [],
	readingTime,
	links = [],
	level = 2,
} = Astro.props;

const Heading = `h${level}` as "h2" | "h3";
---

<!-- One line of a table of contents: title, dot leader, date and reading time. -->
<article class="entry">
	<div class="entry-line">
		<Heading class="entry-title">
			<a href={href} data-astro-prefetch>{title}</a>
		</Heading>
		<span class="entry-leader" aria-hidden="true"></span>
		<p class="entry-meta">
			<time datetime={new Date(date).toISOString()}>{formatCardDate(date)}</time>
			{readingTime && <><span aria-hidden="true"> · </span><span>{readingTime} min read</span></>}
		</p>
	</div>
	{description && <p class="entry-dek">{description}</p>}
	{tags.length > 0 && <Tags tags={tags} />}
	{
		links.length > 0 && (
			<p class="entry-links">
				{links.map((link) => (
					<a class="link-quiet" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				))}
			</p>
		)
	}
</article>
