---
interface Props {
	tags: string[];
	class?: string;
	linked?: boolean;
	limit?: number;
}

const { tags, class: className = "", linked = true, limit } = Astro.props;

const visibleTags = limit ? tags.slice(0, limit) : tags;
---

<!-- Topics are plain small text, comma-separated: no chips, no hashtags -->
<ul class:list={["topics", className]}>
	{
		visibleTags.map((tag) => (
			<li>
				{linked ? <a href={`/tags/${tag}`}>{tag}</a> : <span>{tag}</span>}
			</li>
		))
	}
</ul>

<style>
	.topics {
		display: flex;
		flex-wrap: wrap;
		column-gap: 0.5rem;
		row-gap: 0;
		font-size: 0.875rem;
		line-height: 1.5;
	}

	/* Flex items drop the whitespace Astro leaves between the link and the
	   comma, so the comma sits right after the word. */
	.topics li {
		display: inline-flex;
		min-height: 24px;
		align-items: center;
	}

	.topics li:not(:last-child)::after {
		content: ",";
		color: var(--color-text-muted);
	}

	.topics a {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--color-rule-strong);
		text-underline-offset: 0.25em;
	}

	.topics a:hover {
		color: var(--color-accent);
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.4em;
	}
</style>
