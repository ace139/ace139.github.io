---
interface Props {
	tags: string[];
	class?: string;
	linked?: boolean;
	limit?: number;
}

const { tags, class: className = "", linked = true, limit } = Astro.props;

const visibleTags = limit ? tags.slice(0, limit) : tags;
---

<ul class:list={["topics", className]} aria-label="Topics">
	{
		visibleTags.map((tag) => (
			<li>{linked ? <a href={`/tags/${tag}`}>{tag}</a> : tag}</li>
		))
	}
</ul>
