---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<nav id="main-nav" class="nav" aria-label="Primary">
  <div class="shell">
    <div class="nav-bar">
      <a href="/" class="nav-name" data-astro-prefetch>Soumyo Dey</a>

      <!-- Desktop navigation -->
      <div class="nav-links">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={isActive(link.href) ? 'page' : undefined}
            data-astro-prefetch
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right side controls -->
      <div class="nav-controls">
        <!-- Theme Toggle -->
        <button
          type="button"
          id="theme-toggle"
          aria-label="Toggle theme"
          class="nav-button"
        >
          <!-- Moon icon (shown in dark mode, click to go light) -->
          <svg
            id="theme-icon-dark"
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <!-- Sun icon (shown in light mode, click to go dark) -->
          <svg
            id="theme-icon-light"
            aria-hidden="true"
            class="hidden h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </button>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          id="menu-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="nav-button nav-menu-button"
        >
          <svg
            id="menu-icon-open"
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
          <svg
            id="menu-icon-close"
            aria-hidden="true"
            class="hidden h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="mobile-menu hidden">
    <div class="shell mobile-menu-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-astro-prefetch
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style is:global>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-bar {
    display: flex;
    height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-name:hover {
    color: var(--color-text);
  }

  .nav-links {
    display: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-button {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-secondary);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .nav-button:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem 1.25rem;
  }

  .mobile-menu-links .nav-link {
    padding-block: 0.75rem;
    font-size: 1.0625rem;
  }

  /* Name sits in the label column, links start at the reading column. */
  @media (min-width: 48rem) {
    .nav-bar {
      display: grid;
      grid-template-columns: var(--label-w) minmax(0, 1fr) auto;
      column-gap: var(--label-gap);
    }

    .nav-links {
      display: flex;
    }

    .nav-menu-button,
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu.hidden {
    display: none;
  }
</style>
