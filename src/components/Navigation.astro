---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<!-- Running header: the author's name and three places to turn to. -->
<header id="main-nav" class="running-head">
  <div class="page running-head-inner">
    <a href="/" class="running-head-name" data-astro-prefetch>Soumyo Dey</a>

    <div class="running-head-links">
      <nav aria-label="Primary" class="contents">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            data-astro-prefetch
          >
            {link.label}
          </a>
        ))}
      </nav>

      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <!-- Moon icon (shown in dark mode, click to go light) -->
        <svg
          id="theme-icon-dark"
          aria-hidden="true"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
        <!-- Sun icon (shown in light mode, click to go dark) -->
        <svg
          id="theme-icon-light"
          aria-hidden="true"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>
