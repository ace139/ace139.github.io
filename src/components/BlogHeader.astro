---
import Tags from './Tags.astro';

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  tags?: string[];
  readingTime?: number;
}

const { title, subtitle, date, tags = [], readingTime } = Astro.props;
const isoDate = date.toISOString().slice(0, 10);
---

<header class="post-head grid-12">
  <!-- Meta in the label column, title from column 4: the same grammar as
       every other page. Phones: one compact line above the title. -->
  <dl class="c-label post-meta">
    <div class="post-meta-item">
      <dt class="mono">Published</dt>
      <dd class="mono post-meta-value"><time datetime={date.toISOString()}>{isoDate}</time></dd>
    </div>
    {readingTime && (
      <div class="post-meta-item">
        <dt class="mono">Reading time</dt>
        <dd class="mono post-meta-value">{readingTime} min</dd>
      </div>
    )}
    {tags.length > 0 && (
      <div class="post-meta-item post-meta-topics">
        <dt class="mono">Topics</dt>
        <dd class="post-meta-value"><Tags tags={tags} /></dd>
      </div>
    )}
  </dl>

  <div class="c-body post-heading">
    <h1 class="post-title">{title}</h1>
    {subtitle && <p class="t-lead post-subtitle">{subtitle}</p>}
  </div>
</header>

<style>
  .post-head {
    row-gap: 1.25rem;
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Phones: label + value pairs on one wrapping line. */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .post-meta-item {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .post-meta-value {
    color: var(--color-text);
  }

  /* Wide: stacked marginalia beside the title, top-aligned with it. */
  @media (min-width: 48rem) {
    .post-meta {
      flex-direction: column;
      gap: 1rem;
      padding-top: 0.6rem;
    }

    .post-meta-item {
      flex-direction: column;
      gap: 0.125rem;
    }
  }

  .post-title {
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .post-subtitle {
    max-width: 40rem;
    margin-top: 1.25rem;
  }
</style>
