---
import Tags from './Tags.astro';

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  tags?: string[];
  readingTime?: number;
}

const { title, subtitle, date, tags = [], readingTime } = Astro.props;
const isoDate = date.toISOString().slice(0, 10);
---

<header class="post-head">
  <!-- Meta row: three cells on the grid, labelled like a spec sheet -->
  <dl class="post-meta grid-12">
    <div class="post-meta-cell post-meta-date">
      <dt class="mono">Published</dt>
      <dd class="mono post-meta-value"><time datetime={date.toISOString()}>{isoDate}</time></dd>
    </div>
    {readingTime && (
      <div class="post-meta-cell post-meta-read">
        <dt class="mono">Reading time</dt>
        <dd class="mono post-meta-value">{readingTime} min</dd>
      </div>
    )}
    {tags.length > 0 && (
      <div class="post-meta-cell post-meta-topics">
        <dt class="mono">Topics</dt>
        <dd class="post-meta-value"><Tags tags={tags} /></dd>
      </div>
    )}
  </dl>

  <div class="grid-12 post-title-row">
    <h1 class="c-body post-title">{title}</h1>
    {subtitle && <p class="c-body t-lead post-subtitle">{subtitle}</p>}
  </div>
</header>

<style>
  .post-head {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .post-meta {
    row-gap: 1.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule);
  }

  .post-meta-cell {
    display: grid;
    gap: 0.25rem;
  }

  .post-meta-value {
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .post-meta-date {
      grid-column: 1 / span 3;
    }

    .post-meta-read {
      grid-column: 4 / span 3;
    }

    .post-meta-topics {
      grid-column: 7 / -1;
    }
  }

  .post-title-row {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    row-gap: 1.5rem;
  }

  .post-title {
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4.75rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .post-subtitle {
    max-width: 40rem;
  }
</style>
