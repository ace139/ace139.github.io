---



import type { HeroConfig } from '../utils/hero-config';
import { resolveHeroConfig } from '../utils/hero-config';
import ResponsiveImage from './ResponsiveImage.astro';
import Tags from './Tags.astro';

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  heroImage?: string;
  heroConfig?: HeroConfig;
  readingTime?: number;
  tags?: string[];
}

const { title, subtitle, date, heroImage, heroConfig, readingTime, tags } = Astro.props;

const config = resolveHeroConfig(heroConfig);
---

<header class="article-head">
  <div class="row">
    <div class="marginalia article-meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {readingTime && <span>{readingTime} min read</span>}
      {tags && tags.length > 0 && <Tags tags={tags} />}
    </div>

    <div class="article-titles">
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="lead article-sub">{subtitle}</p>}
    </div>
  </div>

  {heroImage && (
    <div class="row">
      <figure
        class="article-hero row-body"
        style={`--hero-aspect-desktop: ${config.aspectDesktop}; --hero-aspect-mobile: ${config.aspectMobile};`}
      >
        <ResponsiveImage
          src={heroImage}
          alt=""
          class="h-full w-full"
          imageClass="object-cover"
          objectPosition={config.objectPosition}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1152px) 880px, 100vw"
        />
      </figure>
    </div>
  )}
</header>

<style>
  .article-head {
    padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    padding-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .article-meta::before {
    display: none;
  }

  .article-meta :global(.topics) {
    flex-basis: 100%;
    margin-top: 0.25rem;
  }

  @media (min-width: 48rem) {
    .article-meta {
      display: block;
      padding-top: 0.75rem;
      margin-bottom: 0;
    }

    .article-meta::before {
      display: block;
    }

    .article-meta span {
      display: block;
    }

    .article-meta :global(.topics) {
      display: grid;
      gap: 0;
      margin-top: 1rem;
    }
  }

  .article-titles {
    max-width: 44rem;
  }

  .article-sub {
    margin-top: 1.25rem;
    max-width: 36rem;
  }

  .article-hero {
    margin-top: clamp(2rem, 4vw, 3rem);
    aspect-ratio: var(--hero-aspect-mobile, 16 / 9);
    max-height: 30rem;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-surface);
  }

  @media (min-width: 48rem) {
    .article-hero {
      aspect-ratio: var(--hero-aspect-desktop, 21 / 9);
    }
  }

  .article-hero :global(img),
  .article-hero :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
